{
  "expo": {
    "name": "StockBeacon",
    "slug": "stock-beacon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "stockbeacon",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stockbeacon.inventory",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "StockBeacon uses the camera to scan product barcodes for fast stock lookup, inward entry, and physical stock counts.",
        "NSPhotoLibraryUsageDescription": "StockBeacon allows attaching product photos from your library."
      }
    },
    "android": {
      "package": "com.stockbeacon.inventory",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow StockBeacon to access your camera to scan product barcodes offline."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2563EB"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "privacyPolicySummary": "StockBeacon operates 100% offline. All business profiles, product catalogs, and stock ledgers are stored locally on your device."
    }
  }
}
